@page
@model IndexModel
@using CnabParser.Web.Models
@using System.Globalization
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">CNAB Parser</h1>
</div>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="UploadedFile" class="form-label">Select CNAB File</label>
                <input type="file" asp-for="UploadedFile" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Upload and Process</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-4" role="alert">
        @Model.ErrorMessage
    </div>
}

@if (Model.Stores != null && Model.Stores.Any())
{
    <h2 class="mt-5">Transaction Summary</h2>

    <div class="accordion" id="storesAccordion">
        @foreach (var store in Model.Stores)
        {
            var storeId = store.Name.Replace(" ", "");
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@storeId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@storeId" aria-expanded="false" aria-controls="collapse-@storeId">
                        @store.Name (Owner: @store.OwnerName) - Balance: <span class="@(store.Balance >= 0 ? "text-success" : "text-danger") ms-2">@store.Balance.ToString("C", new CultureInfo("pt-BR"))</span>
                    </button>
                </h2>
                <div id="collapse-@storeId" class="accordion-collapse collapse" aria-labelledby="heading-@storeId" data-bs-parent="#storesAccordion">
                    <div class="accordion-body">
                        <h5>Transactions:</h5>
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>CPF</th>
                                    <th>Card</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in store.Transactions)
                                {
                                    <tr>
                                        <td>@transaction.Date</td>
                                        <td>@transaction.Type</td>
                                        <td class="@(transaction.Amount >= 0 ? "text-success" : "text-danger") text-end">@transaction.Amount.ToString("N2", new CultureInfo("pt-BR"))</td>
                                        <td>@transaction.Cpf</td>
                                        <td>@transaction.Card</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}
